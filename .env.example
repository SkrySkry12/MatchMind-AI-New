# Coolify can inject these variables into the Docker Compose deployment.
# For local Docker Compose, copy this file to .env and replace the placeholders.
PORT=4000
NODE_ENV=production
POSTGRES_DB=matchmind
POSTGRES_USER=matchmind
POSTGRES_PASSWORD=replace-with-a-long-random-password
FOOTBALL_API_KEY=
BSD_API_TOKEN=
FOOTBALL_API_BASE_URL=https://v3.football.api-sports.io
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:0.6b
LLM_TIMEOUT_MS=180000
LLM_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DEMO_MODE=false
